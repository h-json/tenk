<?xml version="1.0" encoding="UTF-8"?>
<!--
  로그 스트림이 **셋**이고 보관 기간이 서로 다르다. 헷갈려서 값을 맞추지 말 것.

    ① TENK_ADMIN_AUDIT  관리자 접속기록   13개월  →  admin-audit 볼륨 (/app/logs)
    ② TENK_ACCESS_LOG   이용자 접속기록    3개월  →  app-logs 볼륨   (/app/app-logs)
    ③ 루트(애플리케이션) 오류·운영 로그    3개월  →  app-logs 볼륨   (②와 같은 볼륨)

  왜 파일로 빼는가 — 컨테이너 stdout(도커 json-file)은 **컨테이너에 딸린 파일**이라
  재배포하면 통째로 사라진다(2026-08-08 에 admin-audit 이 실제로 그렇게 9일치를 잃었다).
  개인정보처리방침 §3·§8 에 고지한 보관 기간을 지키려면 ① 전용 파일 + 시간 기준 롤링,
  ② 그 파일을 docker named volume 에 두는 것 **둘 다** 필요하다.

  ⚠️ 보관 기간은 **시간 기준(TimeBasedRollingPolicy)** 이어야 한다. 도커 json-file 처럼
     용량 기준으로 두면 트래픽이 적을 때 **고지한 기간보다 훨씬 오래** 보관하게 된다 —
     고지 위반은 짧은 쪽이 아니라 긴 쪽에서 난다.

  ⚠️ ①은 additivity="false" 로 루트에서 뗀다. 안 그러면 접속기록이 ③(3개월)에도 복사돼
     "13개월 보관"이라는 별도 스트림의 의미가 무너진다. ②도 같은 이유로 뗀다(요청 한 줄마다
     docker compose logs 가 도배되는 것도 막는다).
     단 **local 프로파일에서는 콘솔에도 남긴다** — 개발 중엔 눈으로 봐야 한다.

  ⚠️ <springProfile> 은 <logger> **바깥**에 있어야 한다. 안에 넣으면
     "springProfile elements cannot be nested within an appender/logger/root element"
     WARN 과 함께 통째로 무시된다 — 그래서 local 콘솔 출력이 2026-08-17 까지
     한 번도 동작한 적이 없었다. 두 벌로 나눠 쓰는 게 정석이다.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- 컨테이너에서는 볼륨 경로로 덮어쓴다. 로컬은 ./logs (gitignore 됨). -->
    <springProperty name="auditDir" source="tenk.admin.audit-log-dir" defaultValue="./logs"/>
    <springProperty name="logDir" source="tenk.log.dir" defaultValue="./logs"/>

    <!-- ① 관리자 접속기록 — 13개월 (개인정보처리방침 §8 "1년 이상") -->
    <appender name="ADMIN_AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${auditDir}/admin-audit.log</file>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${auditDir}/admin-audit.%d{yyyy-MM}.log.gz</fileNamePattern>
            <!-- 월 단위 롤링 × 13개월. 고시가 요구하는 "1년 이상"을 한 달 여유와 함께 만족한다. -->
            <maxHistory>13</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ② 이용자 접속기록 — 3개월 (개인정보처리방침 §3) -->
    <appender name="ACCESS_LOG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${logDir}/access.log</file>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${logDir}/access.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <!-- ⚠️ **일** 단위 × 90. ①처럼 월 단위로 하면 최대 4개월이 되어 고지(3개월)를 넘긴다. -->
            <maxHistory>90</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ③ 애플리케이션(오류·운영) 로그 — 3개월. 콘솔은 그대로 두고 보관용 사본을 더한다. -->
    <appender name="APP_LOG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${logDir}/application.log</file>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${logDir}/application.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>90</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <springProfile name="local">
        <logger name="TENK_ADMIN_AUDIT" level="INFO" additivity="false">
            <appender-ref ref="ADMIN_AUDIT_FILE"/>
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="TENK_ACCESS_LOG" level="INFO" additivity="false">
            <appender-ref ref="ACCESS_LOG_FILE"/>
            <appender-ref ref="CONSOLE"/>
        </logger>
    </springProfile>

    <springProfile name="!local">
        <logger name="TENK_ADMIN_AUDIT" level="INFO" additivity="false">
            <appender-ref ref="ADMIN_AUDIT_FILE"/>
        </logger>
        <logger name="TENK_ACCESS_LOG" level="INFO" additivity="false">
            <appender-ref ref="ACCESS_LOG_FILE"/>
        </logger>
    </springProfile>

    <!--
      CONSOLE 을 빼지 말 것 — `docker compose logs -f backend` 가 아무것도 안 보여주게 된다.
      배포 검증·트러블슈팅에서 매번 쓰는 통로다(docker-deployment.md §9.3).
      APP_LOG_FILE 은 그 사본이고, 한 줄이 두 곳에 있으면 **긴 쪽이 실제 보관 기간**이므로
      개인정보처리방침에는 3개월로 적으면 정확하다(json-file 사본은 그보다 먼저 사라진다).
    -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_LOG_FILE"/>
    </root>
</configuration>
